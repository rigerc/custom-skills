{
  "name": "custom-skills",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A custom AutoSkills version-1 skill catalog",
  "scripts": {
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "test": "node --test tests/*.test.mjs && node scripts/validate-catalog.mjs",
    "validate": "node scripts/validate-catalog.mjs",
    "laya:up": "docker compose -f compose.laya.yml up -d --build --wait",
    "laya:down": "docker compose -f compose.laya.yml down",
    "laya:inspect-map": "node scripts/classify-skills.mjs --inspect-map",
    "laya:classify": "node scripts/classify-skills.mjs --mode catalog --output skill-classifications.json",
    "laya:classify:map": "node scripts/classify-skills.mjs --mode map --output autoskills-classified.json",
    "laya:classify:write": "node scripts/classify-skills.mjs --mode catalog --threshold 0.9 --output skill-classifications.json --write",
    "laya:refresh-map": "node scripts/refresh-autoskills-map.mjs",
    "laya:run": "node scripts/run-laya-classification.mjs",
    "laya:run:jev": "node scripts/run-laya-classification.mjs --provider opencode-zen"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
